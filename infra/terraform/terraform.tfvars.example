# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to Git — it is in .gitignore.

aws_region         = "us-east-1"
environment        = "dev"
project_name       = "devsecops"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
instance_type      = "t3.micro"         # or t2.micro — both free tier
key_name           = "my-aws-key"       # your EC2 Key Pair name (no .pem)
allowed_ssh_cidr   = "YOUR.PUBLIC.IP/32" # e.g. curl ifconfig.me then add /32
ami_id             = "ami-0182f373e66f89c85"  # Amazon Linux 2023 us-east-1
